# URL base delle API Laravel, senza slash finale.
# Sviluppo:   http://127.0.0.1:8000/api/v1
# Test (DB separato, porta 8010): http://127.0.0.1:8010/api/v1
# Produzione: https://admin.anticoburger.it/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Facoltativo: registra il service worker anche con `npm run dev`.
# NEXT_PUBLIC_ENABLE_SW=true

# Facoltativo: versione della build (default: timestamp). Cambia l'URL del service worker.
# APP_VERSION=
